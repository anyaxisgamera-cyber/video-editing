 "cues": [
  {
   "start": 0.6,
   "end": 2.31,
   "text": "శోధన ఎప్పుడూ పెద్దగా,",
   "line": 0
  },
  {
   "start": 2.35,
   "end": 4.4,
   "text": "స్పష్టంగా మన ముందుకు రాదు.",
   "line": 0
  },
  {
   "start": 4.7,
   "end": 5.598,
   "text": "కొన్నిసార్లు,",
   "line": 1
  },
  {
   "start": 5.638,
   "end": 7.585,
   "text": "మనం పెరగనిచ్చే ఒక కోరికతో",
   "line": 1
  },
  {
   "start": 7.625,
   "end": 9.188,
   "text": "అది ప్రారంభమవుతుంది.",
   "line": 1
  },
  {
   "start": 9.487,
   "end": 12.525,
   "text": "మన ఎంపికలు మన హృదయంలో మొదలవుతాయి.",
   "line": 2
  },
  {
   "start": 13.137,
   "end": 14.747,
   "text": "ప్రతి శోధన మనం సరైన",
   "line": 2
  },
  {
   "start": 14.787,
   "end": 16.16,
   "text": "మార్గాన్ని ఎంచుకోవాలని",
   "line": 2
  },
  {
   "start": 16.2,
   "end": 17.587,
   "text": "సవాలు చేస్తుంది.",
   "line": 2
  },
  {
   "start": 17.887,
   "end": 19.66,
   "text": "తాత్కాలికమైన కోరికలు నీ",
   "line": 3
  },
  {
   "start": 19.7,
   "end": 21.637,
   "text": "జీవితాన్ని నడిపించనివ్వకు.",
   "line": 3
  },
  {
   "start": 21.938,
   "end": 23.6,
   "text": "శోధనను గుర్తించు.",
   "line": 4
  },
  {
   "start": 24.212,
   "end": 25.862,
   "text": "దేవుని వైపు తిరుగు.",
   "line": 4
  },
  {
   "start": 26.475,
   "end": 28.162,
   "text": "సరైనదాన్ని ఎంచుకో.",
   "line": 4
  },
  {
   "start": 28.812,
   "end": 31.835,
   "text": "యాకోబు 1:14",
   "line": 5
  },
  {
   "start": 31.875,
